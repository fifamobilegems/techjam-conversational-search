# Example environment for the TechJam conversational-search agent.
#
# Copy to `.env` (gitignored) and uncomment what you need. `starter/env.py`
# loads `.env` when the Agent is constructed. Precedence: a variable already set
# in the shell wins over `.env`, and `.env` wins over the in-code default.
#
# The deterministic pipeline scores fully with NONE of these set — official
# scoring may run offline. Never commit real API keys.
#
# Two parsing rules of `starter/env.py` worth knowing, because breaking either
# fails SILENTLY (the agent falls back and reports 0 tokens, with no error):
#   1. Keys are read with `setdefault`, so if the same key appears twice the
#      FIRST occurrence wins. Where alternatives are shown, uncomment ONE.
#   2. Inline comments are NOT stripped -- everything after `=` becomes the
#      value. Put comments on their own line, never after a value.

# =============================================================================
# Reranker weights (starter/retriever.py) — Role D
# =============================================================================
# Which staged-reranker weight set to use.
#   default    — the hand-tuned weights the branch historically shipped.
#   calibrated — fitted on synth/realistic, held out on the ESCI gold rows;
#                lifts the realistic/esci columns markedly at a small official
#                cost. The Agent selects this by default (os.environ.setdefault);
#                set it to `default` here to force the pre-calibration weights.
RERANK_WEIGHTS=calibrated

# Candidate over-fetch multiplier before the prefilter/rerank (integer).
#RERANK_OVERFETCH=3
# Minimum candidates kept after the hard-constraint prefilter (integer).
#RERANK_MIN_SURVIVORS=200
# Drop catalog boilerplate phrases from scoring (1/true/yes).
#RERANK_FILTER_BOILERPLATE=0
# Score raw user-phrase matches (default on; set 0 to disable).
#RERANK_RAW_PHRASES=1

# =============================================================================
# Extractor (starter/extractor.py) — Role B
# =============================================================================
# Comma-separated Tier-1 lexicon attributes. `category` is excluded by default:
# a wrong category guess is penalised rather than ignored. Re-enable only once
# soft-abstention is confirmed on this branch.
#TIER1_ATTRIBUTES=color,material,size,style,brand

# =============================================================================
# Optional LLM extraction tier (state/llm_extractor.py) — Role B
# Off by default. When enabled it only ADDS spans the rules missed; scoring must
# never depend on it, because official scoring may run without network access.
# =============================================================================
# Requires the optional `openai` package:  pip install -r requirements-llm.txt
#
# Enable the additive LLM extraction tier. MUST be 1/true/yes to switch it on.
#TECHJAM_LLM_EXTRACTOR=1
#
# API key — required ONLY when the tier is enabled. Never commit a real key.
#   direct OpenAI : sk-...
#   OpenRouter    : sk-or-v1-...
#OPENAI_API_KEY=sk-your-key-here
#
# Base URL. Leave unset for OpenAI. Set it for any compatible gateway:
#OPENAI_BASE_URL=https://openrouter.ai/api/v1
#
# Model id. Default is gpt-4o-mini, which is the form direct OpenAI expects.
# Gateways namespace their ids: on OpenRouter you MUST use "openai/gpt-4o-mini"
# or the request 404s and the tier silently does nothing. Uncomment ONE of the
# two forms below -- never both (see the duplicate-key note at the top).
# For direct OpenAI the id is the bare form, e.g.  gpt-4o-mini  (this is also
# the built-in default, so you can leave the line below commented out entirely).
# For OpenRouter it must be namespaced:
#TECHJAM_LLM_MODEL=openai/gpt-4o-mini
#
# Hard cap on model calls per process, as a cost guard (default: 250).
#TECHJAM_LLM_MAX_CALLS=250

# =============================================================================
# Optional dense retrieval (retrieval/) — Role D. Not built by default.
# =============================================================================
#EMBEDDING_BACKEND=sentence-transformer
#EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
#EMBEDDING_DEVICE=cpu

# =============================================================================
# Debug / tracing (starter/debug.py, scripts/analyze_trace.py) — Role A
# =============================================================================
# Record BM25 and final candidate id lists into each trace event (1/true/yes).
#AGENT_TRACE_CANDIDATES=0
# File path for the agent debug log (empty disables it).
#AGENT_DEBUG_LOG=
# Catalog path used by scripts/analyze_trace.py.
#TRACE_CATALOG_PATH=data/catalog.jsonl
